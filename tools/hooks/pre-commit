#!/bin/sh
# Runs the docs lint before every commit; errors block the commit, warnings don't.
# Enable once per clone:   git config core.hooksPath tools/hooks
# Skip for one commit:     git commit --no-verify
root=$(git rev-parse --show-toplevel)
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 &&
     "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)" >/dev/null 2>&1; then
    exec "$py" "$root/tools/doclint.py" --quiet
  fi
done
echo "pre-commit: Python 3.7+ not found, skipping the docs lint." >&2
exit 0
