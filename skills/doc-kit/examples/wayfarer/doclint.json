{
  "_comment": "Wayfarer's doclint config. Reproduces the original tools/doclint.py (CONVENTIONS.md §11). Keys: see CONFIG.md.",
  "root": "..",
  "docs_dir": "docs",
  "skip_dirs": ["archive", "templates"],
  "codes": {"file": "CONVENTIONS.md", "pattern": "`([A-Z]{3})`\\s*\\|\\s*([^|]+?\\.md)"},
  "code_path_prefixes": ["", "design/"],
  "id_scheme": {"code": "[A-Z]{3}", "rule": "R", "question": "Q", "decision_prefix": "D", "decision_digits": 3},
  "types": {
    "sdd":       {"required": ["id", "title", "type", "domain", "layer", "status", "updated"], "enums_always": ["layer"], "id_matches_path": true},
    "data":      {"required": ["id", "title", "type", "domain", "status", "updated"], "id_matches_path": true},
    "decisions": {"required": ["id", "title", "type", "domain", "updated"]},
    "registry":  {"required": ["id", "title", "type", "updated"], "id_matches_path": true},
    "vision":    {"required": ["id", "title", "type", "updated"], "id_matches_path": true},
    "ideas":     {"required": ["id", "title", "type", "updated"], "id_matches_path": true}
  },
  "enums": {
    "status": ["idea", "drafting", "settled", "locked", "deferred"],
    "layer": ["L0", "L1", "L2", "L3", "L4"]
  },
  "date_fields": ["updated"],
  "depends_field": "depends_on",
  "unique_id_exempt_types": ["decisions"],
  "decision_log_types": ["decisions"],
  "mirror": {"types": ["sdd", "data"], "from": "design/", "to": "decisions/"},
  "sections": {
    "notes": {"heading": "## working notes", "allowed_status": ["idea", "drafting"], "exempt": true,
              "message": "working notes are only allowed while status is idea or drafting"}
  },
  "tags": {
    "rule": {"types": ["sdd"], "values": ["locked", "leaning", "placeholder"],
             "section_only": {"## provisional rules": "leaning"}},
    "question": {"types": ["sdd"], "values": ["blocking", "major", "minor", "deferred"]}
  },
  "prose": {
    "types": ["sdd", "data", "registry", "vision", "ideas"],
    "checks": ["heading_emoji", "heading_date", "changelog_heading", "star", "strikethrough", "first_person"],
    "patterns": [
      {"regex": "\\bv\\d+\\+?(?![\\w.])", "level": "warn", "message": "release scheduling in spec text (CONVENTIONS §9 rule 11)"}
    ]
  },
  "word_budget": {"sdd": 1500},
  "history_line": "^\\s*-\\s+\\d{4}-\\d{2}-\\d{2}\\s+—",
  "stale_terms": {
    "file": "tools/stale-terms.txt",
    "retired_names": {"file": "GLOSSARY.md", "heading": "## Retired names", "use_column": 1, "pattern_column": 2},
    "exempt": {"exclude": ["decisions/", "CONVENTIONS.md", "GLOSSARY.md", "planning/"], "include": ["planning/OPEN_QUESTIONS.md"]}
  },
  "refs": {
    "exempt": {"exclude": ["decisions/", "CONVENTIONS.md", "planning/"], "include": ["planning/OPEN_QUESTIONS.md"]}
  },
  "index": {"file": "planning/OPEN_QUESTIONS.md", "question_tags": ["blocking"]},
  "expect_front_matter": {"include": ["design/", "decisions/"], "exclude_regex": "^decisions/\\d{4}-|^decisions/README\\.md$"},
  "map": {
    "columns": [["Code", "code"], ["System", "title"], ["Type", "type"], ["Layer", "layer"], ["Status", "status"], ["File", "link"]],
    "sort": ["domain", "code"]
  },
  "plugins": ["wayfarer"]
}
